{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "DATABASE_URL=postgres://booking:booking@localhost:5433/booking JWT_SECRET=dev-only-secret tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && cp -R src/migrations dist/",
    "start": "node dist/index.js",
    "typecheck": "tsc",
    "test": "vitest run",
    "migrate:latest": "DATABASE_URL=postgres://booking:booking@localhost:5433/booking tsx src/migrate-cli.ts latest",
    "migrate:rollback": "DATABASE_URL=postgres://booking:booking@localhost:5433/booking tsx src/migrate-cli.ts rollback",
    "seed": "DATABASE_URL=postgres://booking:booking@localhost:5433/booking tsx src/seed-cli.ts"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "jose": "^6.2.15",
    "knex": "^3.3.0",
    "luxon": "^3.7.2",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
